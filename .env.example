# Copy to .env (git-ignored) and fill in. Never commit .env. The README explains each one.

# Firebase Auth: the players' logins (their ID tokens are checked with the project id, no key needed)
FIREBASE_PROJECT_ID=

# PocketBase, on the same VPS, and the superuser the game server signs in as
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# The admin app's accounts (comma-separated e-mails): god view, /api/admin/*
ADMIN_EMAILS=

# In-room voice (LiveKit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Moving from Firebase only: scripts/migrate-from-firebase.ts reads the service account from
# service-account.json (git-ignored), or from FIREBASE_SERVICE_ACCOUNT (its JSON on one line)
# FIREBASE_SERVICE_ACCOUNT=
